{
  "name": "super-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Super App Monorepo Architecture with Micro-Apps",
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "lodash-es": "^4.18.1",
    "react-i18next": "^17.0.13",
    "zustand": "^5.0.15"
  }
}
